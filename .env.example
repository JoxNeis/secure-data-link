# Settings for secure-data-link. Copy to .env, or run `python setup-credentials.py`,
# which creates .env from this file and fills in ENCRYPTION_KEY.
# Real environment variables override these values. Relative paths are relative to this file.

# ---- Connection --------------------------------------------------------------
# Server: network interface to listen on (0.0.0.0 = every interface)
LISTEN_HOST=0.0.0.0
# Client: address of the server device
SERVER_HOST=127.0.0.1
# Both: TCP port
SERVER_PORT=5000
# Both: seconds to keep trying to connect before giving up ("none" = keep trying forever)
CONNECT_TIMEOUT=300
# Client: seconds between connection attempts
RETRY_INTERVAL=2

# ---- Mutual TLS --------------------------------------------------------------
# Both devices need the CA certificate; each needs only its own certificate and key.
TLS_CA_CERT=certs/ca.crt
TLS_SERVER_CERT=certs/server.crt
TLS_SERVER_KEY=certs/server.key
TLS_CLIENT_CERT=certs/client.crt
TLS_CLIENT_KEY=certs/client.key
# Only if your private key is password-protected
TLS_KEY_PASSWORD=
# Client: name the server certificate must carry. Certificates from setup-credentials.py
# always include this one, so the server's IP address can change without new certificates.
TLS_SERVER_NAME=secure-data-link-server

# ---- Message encryption (AES-256-GCM, on top of TLS) ------------------------
# 32 random bytes in base64. Must be IDENTICAL on both devices. Keep it secret.
ENCRYPTION_KEY=
